APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/investvantage.db

POSTGRES_DB=investvantage
POSTGRES_USER=investvantage_app
POSTGRES_PASSWORD=replace-with-a-secret

# Add real values only to .env or a secret manager. Never commit them.
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
TELEGRAM_BOT_TOKEN=
JWT_SECRET=

# Safety boundary: live trading remains disabled.
TRADING_MODE=paper
ENABLE_BROKER_ORDERS=false
